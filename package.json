{
  "name": "shopee-affiliate",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:seed": "node --env-file=.env.local --experimental-strip-types scripts/seed-mongodb.ts",
    "db:import-products": "node --env-file=.env.local --experimental-strip-types scripts/import-affiliate-products.ts",
    "db:audit-products": "node --env-file=.env.local --experimental-strip-types scripts/audit-affiliate-products.ts",
    "db:migrate-products": "node --env-file=.env.local --experimental-strip-types scripts/migrate-affiliate-products-v2.ts",
    "check": "npm run test && npm run lint && npm run build"
  },
  "dependencies": {
    "mongodb": "^6.21.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
